# RustClaw configuration
# Copy this file to config/.env and fill in your values.

# ── Credentials ──────────────────────────────────────────────────────────────
# API key for the LLM provider (required).
# Also accepts OPENCODE_API_KEY as a fallback variable name.
TOKEN=your_api_key_here

# ── Provider / model ─────────────────────────────────────────────────────────
# Provider selection (default: opencode-go)
# Options: opencode-go, deepinfra, openrouter, moonshot, huggingface,
#          villamarket, anthropic
PROVIDER=opencode-go

# Model (default: per-provider; see src/harness/provider/catalog.rs)
MODEL=deepseek-v4-flash

# Override the provider endpoint (optional; defaults per provider)
# BASE_URL=https://api.deepinfra.com/v1/openai

# ── Runtime limits ───────────────────────────────────────────────────────────

# Max tool-calling iterations per turn (default: 50)
MAX_ITERATIONS=50

# Max context window tokens; triggers automatic compaction (default: 100000)
MAX_CONTEXT_TOKENS=100000

# Sampling temperature (default: 0.7)
TEMPERATURE=0.7

# ── UI ───────────────────────────────────────────────────────────────────────
# Force the UI surface: cli or tui (default: tui when stdout is a TTY)
# RUSTCLAW_UI=tui

# Color theme: cyberclaw, aurora, ember, mono
# RUSTCLAW_THEME=cyberclaw

# Extra directory to discover skills from (optional)
# RUSTCLAW_SKILLS_DIR=/path/to/skills

# NO_COLOR=1 disables colors entirely (forces the mono theme)
